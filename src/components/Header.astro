---
import { site } from "../site.config";
---

<header class="site-header">
	<nav class="container site-header__inner" aria-label="Principale">
		<a class="site-header__brand" href="#top">{site.name}</a>

		<div class="site-header__nav">
			{site.nav.map((item) => (
				<a class="site-header__link" href={item.href}>{item.label}</a>
			))}
			<a
				class="site-header__cv"
				href={site.cv.href}
				download={site.cv.fileName}
			>
				{site.cv.shortLabel}
			</a>
		</div>
	</nav>
</header>
