---
import { site } from "../site.config";
---

<header class="site-header">
	<nav class="container site-header__inner" aria-label="Main">
		<a class="site-header__brand" href="#top">{site.name}</a>

		<ul class="site-header__nav">
			<li><a class="site-header__link" href="#top">Home</a></li>
			{site.nav.map((item) => (
				<li>
					<a class="site-header__link" href={item.href}>{item.label}</a>
				</li>
			))}
		</ul>
	</nav>
</header>
