---
import { getCollection } from "astro:content";

interface Props {
	title?: string;
}

const { title } = Astro.props;

const experiences = (await getCollection("experiences")).sort((a, b) =>
	b.data.start.localeCompare(a.data.start),
);
---

<section class="section" id="experience">
	<div class="container">
		{title && <h2 class="section__title">{title}</h2>}

		{
			experiences.length > 0 ? (
				<ol class="timeline">
					{experiences.map((item) => {
						const period = item.data.end
							? item.data.end === item.data.start
								? item.data.start
								: `${item.data.start} — ${item.data.end}`
							: `${item.data.start} — Présent`;

						return (
							<li class:list={["timeline__item", `accent-${item.data.accent}`]}>
								<span class="timeline__period">{period}</span>

								<h3 class="timeline__role">{item.data.role}</h3>
								<p class="timeline__company">{item.data.company}</p>
								<p class="timeline__desc">{item.data.description}</p>

								{
									item.data.stack.length > 0 && (
										<ul class="tags">
											{item.data.stack.map((tech) => (
												<li class="tag">{tech}</li>
											))}
										</ul>
									)
								}
							</li>
						);
					})}
				</ol>
			) : (
				<p class="empty">
					Ajoutez des expériences dans <code>src/content/experiences</code>.
				</p>
			)
		}
	</div>
</section>
