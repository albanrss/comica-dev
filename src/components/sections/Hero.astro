---
import { site } from "../../site.config";

interface Props {
	title?: string;
}
---

<section class="section hero" id="top">
	<div aria-hidden="true">
		<span class="blob blob--blue"></span>
		<span class="blob blob--pink"></span>
		<span class="blob blob--green"></span>
	</div>

	<div class="container hero__inner">
		{site.role && <p class="hero__eyebrow">{site.role}</p>}
		<h1 class="hero__name">{site.name}</h1>
		{site.tagline && <p class="hero__tagline">{site.tagline}</p>}
		{site.availability && <p class="hero__note">{site.availability}</p>}

		<div class="hero__actions">
			<a class="btn" href={site.cv.href} download={site.cv.fileName}>
				{site.cv.label}
			</a>
			<a class="btn btn--ghost" href={site.heroCta.href}>
				{site.heroCta.label}
			</a>
		</div>
	</div>
</section>
