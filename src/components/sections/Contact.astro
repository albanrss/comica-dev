---
import { site } from "../../site.config";

interface Props {
	title?: string;
}

const { title } = Astro.props;
const hasContent = Boolean(site.email || site.phone || site.socials.length);
---

<section class="section" id="contact">
	<div class="container contact">
		{title && <h2 class="section__title">{title}</h2>}

		{
			hasContent ? (
				<>
					{site.email && (
						<a class="contact__email" href={`mailto:${site.email}`}>
							{site.email}
						</a>
					)}
					{site.phone && (
						<a class="contact__phone" href={`tel:${site.phone.replace(/\s/g, "")}`}>
							{site.phone}
						</a>
					)}

					<div class="contact__links">
						<a class="pill" href={site.cv.href} download={site.cv.fileName}>
							{site.cv.label}
						</a>
						{site.socials.map((social) => (
							<a class="pill" href={social.href} target="_blank" rel="noopener">
								{social.label}
							</a>
						))}
					</div>
				</>
			) : (
				<p class="empty">
					Ajoutez votre email et vos liens sociaux dans <code>src/site.config.ts</code>.
				</p>
			)
		}
	</div>
</section>
