---
import { site } from "../../site.config";

interface Props {
	title?: string;
}

const { title } = Astro.props;
const meta = [site.location, site.email, site.phone].filter(Boolean);
---

<section class="section" id="a-propos">
	<div class="container">
		{title && <h2 class="section__title">{title}</h2>}

		{
			site.bio ? (
				<p class="about__text">{site.bio}</p>
			) : (
				<p class="empty">
					Ajoutez votre bio dans <code>src/site.config.ts</code>.
				</p>
			)
		}

		{
			meta.length > 0 && (
				<div class="about__meta">
					{site.location && <span class="tag accent-grey">{site.location}</span>}
					{site.email && <span class="tag accent-blue">{site.email}</span>}
					{site.phone && <span class="tag accent-green">{site.phone}</span>}
				</div>
			)
		}
	</div>
</section>
